ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-chars
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# 如需指定共享凭证 profile，可额外设置非空 AWS_PROFILE。
SSO_REGION=us-east-1
KIRO_REGION=us-east-1
IDENTITY_STORE_ID=d-xxxxxxxxxx
INSTANCE_ARN=arn:aws:sso:::instance/ssoins-xxxxxxxxxxxxxxxx
# 仅 Docker Compose 使用；非 Docker 安装可忽略。
AWS_CREDENTIALS_DIR=/home/ec2-user/.aws

# Kiro User Activity Reports（留空时概览显示“未配置”）
REPORT_BUCKET=
REPORT_PREFIX=user-activity-reports
REPORT_OVERAGE_PRICE_PER_CREDIT=0.04